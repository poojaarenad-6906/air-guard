# AI AirGuard — Environment Configuration
# Copy this file to .env and fill in your keys.
# The app works WITHOUT any keys using clearly-labelled demo/sample data.
# Priority order when multiple keys are set: IBM watsonx → Gemini → Groq → Demo

# ── Air Quality Data (OpenWeatherMap) ─────────────────────────────────────────
# Get a FREE key at: https://openweathermap.org/appid
# Enables live AQI, PM2.5, PM10 data for any city worldwide.
VITE_OWM_API_KEY=your_owm_api_key_here

# ── AI Chat Assistant — IBM watsonx.ai ────────────────────────────────────────
# IBM Cloud API key: https://cloud.ibm.com/iam/apikeys
# Project ID: inside your watsonx.ai project → Manage → General → Project ID
# Model list: https://dataplatform.cloud.ibm.com/docs/content/wsj/analyze-data/fm-models.html
VITE_WATSONX_API_KEY=Yh0RwH_0NlWOTc4FmHEm1ocKoS0hzdtAB3YfOgyXuOhZ
VITE_WATSONX_PROJECT_ID=e5983da3-1f93-4185-958b-f7d2407081e9_here
VITE_WATSONX_URL=https://us-south.ml.cloud.ibm.com
VITE_WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2

# ── AI Chat Assistant — Google Gemini ─────────────────────────────────────────
# Get a FREE key at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_MODEL_ID=gemini-1.5-flash

# ── AI Chat Assistant — Groq (llama3) ─────────────────────────────────────────
# Get a FREE key at: https://console.groq.com
VITE_GROQ_API_KEY=your_groq_api_key_here
VITE_GROQ_MODEL_ID=llama3-8b-8192
